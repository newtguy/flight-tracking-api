
### Create a fictional airport
POST http://localhost:8080/airports
Content-Type: application/json

{
  "name": "Dallas Fictional International",
  "iataCode": "DFX",
  "icaoCode": "KDFX",
  "city": "Dallas",
  "country": "United States",
  "latitude": 32.8998,
  "longitude": -97.0403,
  "elevation": 607
}

### Create a fictional flight
POST http://localhost:8080/flights
Content-Type: application/json

{
  "flightNumber": "Flt1234",
  "airline": "Northstar Airways",
  "aircraftType": "Boeing 737-800",
  "departureAirport": "DFX",
  "arrivalAirport": "LAX",
  "status": "En Route",
  "altitude": 35000,
  "speed": 450,
  "latitude": 34.2,
  "longitude": -112.1
}

